# Copy to .env.local (gitignored) and fill in from Supabase Project Settings → API.
# Also set these on Vercel → Environment Variables for Preview/Production.
#
# Client (browser / Vercel NEXT_PUBLIC_*): anon key + user JWT only.
# NEVER put service_role in NEXT_PUBLIC_* or commit it. service_role bypasses RLS —
# use only on trusted servers / `supabase db dump` / Dashboard SQL / roster seed.
# NEVER put Kakao Client Secret in git or NEXT_PUBLIC_* — it lives in
# Supabase Dashboard → Authentication → Providers → Kakao AND (for OIDC path)
# in .env.local as KAKAO_CLIENT_SECRET only.

# Project URL only — do NOT append /rest/v1 (that breaks Storage + supabase-js).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: canonical site origin for OAuth redirectTo (Vercel Production).
# Locally the app uses window.location.origin (http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Kakao — preferred OIDC path (no account_email → avoids KOE205)
# ---------------------------------------------------------------------------
# REST API Key = Supabase Kakao Client ID (public). Enables /api/auth/kakao/start.
NEXT_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key
# JavaScript key (Kakao Developers → 앱 → 앱 키 → JavaScript 키).
# Required for in-app 「카톡으로 보내기」 (Kakao.Share). NOT the same value as REST.
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key
# Same Client Secret as Supabase Auth → Kakao (server only, never NEXT_PUBLIC_*).
KAKAO_CLIENT_SECRET=your_kakao_client_secret
#
# Kakao share (JS SDK) platform checklist:
#   Platform → Web → 사이트 도메인:
#     http://localhost:3000
#     https://daily-qt-dream.vercel.app  (or NEXT_PUBLIC_SITE_URL)
#   Product settings → Kakao Talk Share → ON (default for most apps).
#
# Kakao Developers checklist for OIDC path:
#   1) Kakao Login ON
#   2) OpenID Connect ON (needed for id_token)
#   3) Consent Items: profile_nickname + profile_image only (NO account_email)
#   4) REST API key → Redirect URI:
#        http://localhost:3000/api/auth/kakao/callback
#        https://YOUR_VERCEL_DOMAIN/api/auth/kakao/callback
#   5) Supabase Kakao provider: keep “Allow users without an email” ON
#
# Why not only signInWithOAuth?
#   Supabase GoTrue hardcodes account_email for Kakao and still requests it even
#   when client scopes omit email (KOE205). Fix PR supabase/auth#2579 not merged
#   as of 2026-10. Our OIDC route controls scope ourselves.
#
# Fallback if OIDC env missing: signInWithOAuth(profile only). Still KOE205 unless
# Minzi enables 카카오계정(이메일) as optional (Biz App) — last resort only.

# ---------------------------------------------------------------------------
# Also keep (Supabase Auth URL allowlist) for provider fallback / Site URL:
#   Site URL: http://localhost:3000 (dev) or Vercel URL (prod)
#   Additional Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://YOUR_VERCEL_DOMAIN/auth/callback
# Kakao → Supabase provider callback (if using built-in provider):
#   https://jycmnpdcawqpwzaseorh.supabase.co/auth/v1/callback
#
# After login, apply once:
#   supabase/migrations/20261117_kakao_community_verify.sql
# Do NOT apply 20261118_rls_security_harden.sql until Kakao works (DQ-699).

# Optional local dump (scripts/backup-supabase.sh) — keep in .env.local only:
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# SUPABASE_PROJECT_REF=your_project_ref
# SUPABASE_ACCESS_TOKEN=sbp_...   # CLI login token if using `supabase db dump --project-ref`
#
# Avatar Storage download (same npm run backup:supabase):
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Dashboard → Settings → API → service_role (server/local only)
# (anon key above also works while `avatars` bucket stays public-read)
